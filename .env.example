# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004
# Optional: public base URL for objects (leave blank to use presigned URLs only)
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K001abcdefghijklmnopqrstuvwxyz0
# B2_BUCKET_NAME=my-clip-renders
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://s3.us-west-004.backblazeb2.com/my-clip-renders

# --- RIFE model (optional overrides) ---
# Weights are fetched by `pnpm setup:rife` from this pinned HuggingFace mirror.
# Defaults are a verified HDv3 arch+weights pair; override to use your own.
# RIFE_WEIGHTS_HF_REPO=AlexWortega/RIFE
# RIFE_WEIGHTS_HF_FILE=flownet.pkl
# RIFE_WEIGHTS_HF_REVISION=440cdec905de98e1d7e81f65d2c88a08da7cb4e2
# RIFE_MODEL_DIR=models/rife

# Device auto-detects CUDA -> Apple MPS -> CPU (defaults to CPU). Force with:
# DEVICE=cpu
# Cap frames for a fast CPU demo (raise for a full clip):
# MAX_SOURCE_FRAMES=240
