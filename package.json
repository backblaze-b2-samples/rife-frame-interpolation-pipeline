{
  "name": "rife-frame-interpolation-pipeline",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @rife-frame-interpolation-pipeline/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @rife-frame-interpolation-pipeline/web build",
    "typecheck": "pnpm --filter @rife-frame-interpolation-pipeline/web typecheck",
    "lint": "pnpm --filter @rife-frame-interpolation-pipeline/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @rife-frame-interpolation-pipeline/web exec playwright test",
    "setup:rife": "cd services/api && .venv/bin/python scripts/setup_rife.py",
    "seed:demo": "cd services/api && .venv/bin/python scripts/seed_demo.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "1.19.15",
      "ajv@<7": "6.14.0",
      "ajv@>=7 <9": "8.18.0",
      "body-parser": "2.3.0",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "@babel/helper-compilation-targets>browserslist": "4.28.8",
      "shadcn>browserslist": "4.28.8",
      "esbuild": "0.25.0",
      "express-rate-limit": "8.2.2",
      "fast-uri": "3.1.6",
      "flatted": "3.4.2",
      "hono": "4.12.34",
      "@humanfs/node": "0.16.8",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "minimatch@<4": "3.1.4",
      "minimatch@>=9 <10": "9.0.7",
      "minimatch@>=10 <11": "10.2.3",
      "nanoid": "3.3.18",
      "path-to-regexp@>=8 <9": "8.4.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "postcss": "8.5.23",
      "postcss-selector-parser": "7.1.5",
      "qs": "6.16.0",
      "sharp": "0.35.3",
      "shell-quote": "1.9.0",
      "vite": "6.4.3"
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  }
}
